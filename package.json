{
  "name": "sudoku-game",
  "version": "1.0.0",
  "description": "Sudoku Game",
  "author": "Poya",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "desktop": "electron-builder --win --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.poyatech.sudoku",
    "productName": "Sudoku",
    "asar": true,
    "files": [
      "index.html",
      "script.js",
      "style.css",
      "electron/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Sudoku-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false
    }
  }
}
